package templates

import "github.com/vishnuj16/dear-chaya/story"

// AdminDialogs holds the hidden author UI. It opens on a triple-click of the
// footer "©" or Ctrl+Shift+A. Signed out, that shows the password prompt;
// signed in, it shows a sign-out card, and the header's Edit Story button
// opens the editor (only rendered for the author).
templ AdminDialogs(v story.View, admin bool) {
	<div
		x-data={ "admin(" + boolJS(admin) + ")" }
		x-on:admin-open.window="open()"
		x-on:story-edit.window="openEditor()"
		x-on:admin-logout.window="logout()"
		x-on:keydown.window="shortcut($event)"
		x-on:keydown.escape.window="close()"
	>
		@dialog("login", "Author sign-in") {
			if admin {
				<p class="mb-5 font-sans text-sm text-ink/70 dark:text-mist/70">You're signed in as the author. Use <strong>Edit Story</strong> in the top bar, or the <strong>Delete</strong> links on readers' notes.</p>
				<div class="flex justify-end gap-2">
					@button("secondary", "close()") {
						Close
					}
					@button("primary", "logout()") {
						Sign out
					}
				</div>
			} else {
				<form x-on:submit.prevent="login()" class="space-y-4">
					<div>
						<label for="admin-password" class="mb-1 block font-sans text-sm text-ink/70 dark:text-mist/70">Author password</label>
						<input
							id="admin-password"
							type="password"
							autocomplete="current-password"
							x-model="password"
							x-ref="password"
							required
							class="w-full rounded-md border border-page-edge bg-white/60 px-3 py-2 font-sans text-base text-ink outline-none focus:border-pen dark:border-night-edge dark:bg-night-desk/60 dark:text-mist dark:focus:border-gold"
						/>
					</div>
					@formError()
					<div class="flex justify-end gap-2">
						@button("secondary", "close()") {
							Cancel
						}
						<button type="submit" class={ buttonClass("primary") } x-bind:disabled="busy">
							<span x-show="!busy">Unlock</span>
							<span x-show="busy" x-cloak>Checking…</span>
						</button>
					</div>
				</form>
			}
		}
		if admin {
			@editor(v)
		}
	</div>
}

// dialog is a centred card over a dimmed backdrop. Clicking the backdrop or
// pressing Escape closes it.
templ dialog(name, title string) {
	<div
		x-show={ "openDialog === '" + name + "'" }
		x-cloak
		x-transition.opacity
		class="fixed inset-0 z-50 grid place-items-center bg-ink/40 p-4 backdrop-blur-sm dark:bg-black/60"
		x-on:click.self="close()"
	>
		<div
			role="dialog"
			aria-modal="true"
			aria-labelledby={ "dialog-" + name + "-title" }
			class="w-full max-w-sm rounded-lg border border-page-edge bg-page p-6 text-ink shadow-xl dark:border-night-edge dark:bg-night-page dark:text-mist"
		>
			<h2 id={ "dialog-" + name + "-title" } class="mb-4 font-script text-3xl font-bold text-pen dark:text-gold">{ title }</h2>
			{ children... }
		</div>
	</div>
}

// editor is the full story editor: title and the raw markdown body. The
// textarea is filled server-side (escaped by templ), not bound with x-model,
// so a large story isn't copied into Alpine state on every keystroke.
templ editor(v story.View) {
	<div
		x-show="openDialog === 'editor'"
		x-cloak
		x-transition.opacity
		class="fixed inset-0 z-50 flex items-stretch justify-center bg-ink/40 p-2 backdrop-blur-sm sm:items-center sm:p-6 dark:bg-black/60"
	>
		<form
			role="dialog"
			aria-modal="true"
			aria-labelledby="editor-title"
			x-on:submit.prevent="saveStory()"
			class="flex max-h-full w-full max-w-3xl flex-col rounded-lg border border-page-edge bg-page text-ink shadow-xl sm:h-[85dvh] dark:border-night-edge dark:bg-night-page dark:text-mist"
		>
			<div class="flex items-center justify-between gap-4 border-b border-page-edge px-5 py-3 dark:border-night-edge">
				<h2 id="editor-title" class="font-script text-3xl font-bold text-pen dark:text-gold">Edit story</h2>
				<button type="button" x-on:click="logout()" class="font-sans text-xs text-ink/60 underline-offset-2 hover:underline dark:text-mist/60">Sign out</button>
			</div>
			<div class="flex min-h-0 flex-1 flex-col gap-3 px-5 py-4 font-sans">
				<div>
					<label for="editor-story-title" class="mb-1 block text-sm text-ink/70 dark:text-mist/70">Title</label>
					<input
						id="editor-story-title"
						type="text"
						maxlength="120"
						value={ v.Title }
						x-ref="title"
						x-on:input="dirty = true"
						class="w-full rounded-md border border-page-edge bg-white/60 px-3 py-2 text-base outline-none focus:border-pen dark:border-night-edge dark:bg-night-desk/60 dark:focus:border-gold"
					/>
				</div>
				<div class="flex min-h-0 flex-1 flex-col">
					<label for="editor-story-body" class="mb-1 block text-sm text-ink/70 dark:text-mist/70">Story</label>
					<textarea
						id="editor-story-body"
						x-ref="body"
						x-on:input="dirty = true"
						spellcheck="true"
						class="min-h-[50dvh] w-full flex-1 resize-none rounded-md border border-page-edge bg-white/60 px-3 py-2 font-mono text-sm leading-relaxed outline-none focus:border-pen sm:min-h-0 dark:border-night-edge dark:bg-night-desk/60 dark:focus:border-gold"
					>{ v.Raw }</textarea>
					<p class="mt-2 text-xs text-ink/55 dark:text-mist/50">
						Blank line = new paragraph · <code>*italics*</code> · start a paragraph with <code>&gt; </code> { "for a highlighted thought" }
					</p>
				</div>
				@formError()
			</div>
			<div class="flex justify-end gap-2 border-t border-page-edge px-5 py-3 dark:border-night-edge">
				@button("secondary", "close()") {
					Cancel
				}
				<button type="submit" class={ buttonClass("primary") } x-bind:disabled="busy">
					<span x-show="!busy">Save story</span>
					<span x-show="busy" x-cloak>Saving…</span>
				</button>
			</div>
		</form>
	</div>
}

templ formError() {
	<p class="min-h-5 font-sans text-sm text-rule dark:text-[#e8908a]" role="alert" x-text="error"></p>
}

templ button(kind, onClick string) {
	<button type="button" class={ buttonClass(kind) } x-on:click={ onClick }>
		{ children... }
	</button>
}

func buttonClass(kind string) string {
	base := "rounded-md px-4 py-2 font-sans text-sm font-medium transition focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-pen disabled:cursor-wait disabled:opacity-60 dark:focus-visible:outline-gold "
	if kind == "primary" {
		return base + "bg-pen text-page hover:bg-pen/90 dark:bg-gold dark:text-night-page dark:hover:bg-gold/90"
	}
	return base + "text-ink/70 hover:bg-callout dark:text-mist/70 dark:hover:bg-night-callout"
}

func boolJS(b bool) string {
	if b {
		return "true"
	}
	return "false"
}
