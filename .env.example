# Copy to .env for local development (`make dev` loads it), and add the same
# values in Vercel -> Project -> Settings -> Environment Variables.
# Never commit .env; it is already in .gitignore and .vercelignore.

# Upstash Redis -> your database -> "REST API" section (copy both values).
# Without these, `make dev` uses a temporary in-memory store; on Vercel the
# site refuses to start without them, so comments can never be silently lost.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Author sign-in. Generate both with `make admin-secrets` (keep the single
# quotes here: the hash contains '$'). Leave empty to disable the admin tools.
ADMIN_PASSWORD_HASH=
JWT_SECRET=

# Optional: Google Analytics 4 measurement ID (looks like G-XXXXXXXXXX).
GA_MEASUREMENT_ID=
